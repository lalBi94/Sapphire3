{
  "applicationId": "local.sapphire3.app",
  "version": "0.1.0",
  "applicationName": "Sapphire 3",
  "applicationIcon": "src/assets/branding/01_WEB/PNG_transparent/sapphire3_logo_512x512.png",
  "author": "Sapphire 3 contributors",
  "description": "Visual programming workspace with an independent typed AST",
  "copyright": "Copyright (c) 2026 Sapphire 3 contributors",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "enableExtensions": false,
  "nativeAllowList": ["os.showSaveDialog", "os.showOpenDialog", "os.showFolderDialog", "os.showMessageBox", "os.open", "os.spawnProcess", "os.updateSpawnedProcess", "os.getPath", "app.exit", "net.request", "window.isFullScreen", "window.setFullScreen", "window.exitFullScreen", "clipboard.readText", "clipboard.writeText", "clipboard.getFormat", "clipboard.clear", "filesystem.readFile", "filesystem.readBinaryFile", "filesystem.readDirectory", "filesystem.writeFile", "filesystem.writeBinaryFile", "filesystem.appendBinaryFile", "filesystem.getStats", "filesystem.move", "filesystem.remove", "filesystem.createDirectory", "storage.setData", "storage.getData", "storage.getKeys"],
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "Sapphire 3",
      "icon": "/src/assets/branding/01_WEB/PNG_transparent/sapphire3_logo_256x256.png",
      "width": 1100,
      "height": 760,
      "minWidth": 480,
      "minHeight": 320,
      "center": true,
      "resizable": true,
      "enableInspector": true,
      "injectGlobals": true,
      "exitProcessOnClose": true,
      "useSavedState": false
    }
  },
  "cli": {
    "binaryName": "sapphire3",
    "binaryVersion": "6.10.0",
    "resourcesPath": "/dist/",
    "distributionPath": "/build/",
    "frontendLibrary": {
      "projectPath": "/",
      "devUrl": "http://127.0.0.1:5173",
      "devCommand": "pnpm dev:web",
      "buildCommand": "pnpm build"
    }
  }
}
