{
  "applicationId": "local.sapphire3.app",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "enableExtensions": false,
  "nativeAllowList": ["os.showSaveDialog", "os.showOpenDialog", "os.showMessageBox", "filesystem.readFile", "filesystem.writeFile", "filesystem.getStats", "filesystem.move", "filesystem.remove", "storage.setData", "storage.getData", "storage.getKeys"],
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "Sapphire 3",
      "width": 1100,
      "height": 760,
      "minWidth": 480,
      "minHeight": 320,
      "center": true,
      "resizable": true,
      "enableInspector": true,
      "injectGlobals": true,
      "exitProcessOnClose": true,
      "useSavedState": false
    }
  },
  "cli": {
    "binaryName": "sapphire3",
    "binaryVersion": "6.10.0",
    "resourcesPath": "/dist/",
    "distributionPath": "/build/",
    "frontendLibrary": {
      "projectPath": "/",
      "devUrl": "http://127.0.0.1:5173",
      "devCommand": "pnpm dev:web",
      "buildCommand": "pnpm build"
    }
  }
}
