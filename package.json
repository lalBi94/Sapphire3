{
  "name": "sapphire-3",
  "private": true,
  "version": "0.1.0-beta.8",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test": "node --test --test-concurrency=4 tests/logic/*.test.js tests/workspace/*.test.js tests/transpilation/*.test.js tests/sdk/*.test.js tests/runtime/*.test.js tests/transpiler/*.test.js tests/debug/*.test.js tests/project/*.test.js tests/graph/*.test.js",
    "sdk:build": "pnpm --filter @sapphire3/core build",
    "sdk:test": "node --test tests/sdk/*.test.js",
    "sdk:pack": "pnpm --filter @sapphire3/core run pack",
    "runtime:build": "pnpm --filter @sapphire3/runtime build",
    "runtime:test": "node --test tests/runtime/*.test.js",
    "runtime:pack": "pnpm --filter @sapphire3/runtime run pack",
    "transpiler:build": "pnpm --filter @sapphire3/Transpiler build",
    "transpiler:test": "node --test tests/transpiler/*.test.js",
    "transpiler:pack": "pnpm --filter @sapphire3/Transpiler run pack",
    "debug:build": "pnpm --filter @sapphire3/debug build",
    "debug:test": "node --test tests/debug/*.test.js",
    "debug:pack": "pnpm --filter @sapphire3/debug run pack",
    "project:build": "pnpm --filter @sapphire3/project build",
    "project:test": "node --test tests/project/*.test.js",
    "project:pack": "pnpm --filter @sapphire3/project run pack",
    "graph:build": "pnpm --filter @sapphire3/graph build",
    "graph:test": "node --test tests/graph/*.test.js",
    "graph:pack": "pnpm --filter @sapphire3/graph run pack",
    "docs:ast": "powershell -NoProfile -File scripts/build-ast-doc.ps1",
    "dashboards:build": "node scripts/build-dashboard-showcase.mjs",
    "site:search": "node abstract/visual/scripts/build-search.mjs",
    "site:test": "node --test abstract/visual/scripts/test-site.mjs",
    "presence:build": "node scripts/build-presence.mjs",
    "presence:test": "node scripts/test-presence.mjs",
    "presence:ipc-test": "node scripts/test-presence-ipc.mjs",
    "presence:nodiscord-test": "node scripts/test-presence-nodiscord.mjs",
    "dev": "neu run",
    "dev:web": "vite",
    "build": "vite build",
    "dist:win": "node scripts/build-windows.mjs",
    "dist:linux": "node scripts/build-windows.mjs && node scripts/build-linux.mjs",
    "dist:mac": "node scripts/build-windows.mjs && node scripts/build-macos.mjs",
    "dist:all": "node scripts/build-windows.mjs && node scripts/build-linux.mjs && node scripts/build-macos.mjs",
    "dist:installer": "node scripts/build-windows.mjs && node scripts/build-installer.mjs",
    "preview": "vite preview",
    "desktop:setup": "neu update",
    "desktop:start": "pnpm build && .\\bin\\neutralino-win_x64.exe --load-dir-res --path=."
  },
  "dependencies": {
    "@neutralinojs/lib": "6.10.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.64.0",
    "mafs": "^0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "@sapphire3/core": "workspace:*",
    "@sapphire3/debug": "workspace:*",
    "@sapphire3/project": "workspace:*",
    "@sapphire3/graph": "workspace:*",
    "@sapphire3/runtime": "workspace:*",
    "@sapphire3/Transpiler": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.10.2",
    "vite": "8.3.5"
  }
}
