{
  "name": "@sapphire3/graph",
  "version": "0.1.0",
  "description": "Headless graph SDK for Sapphire 3 dependency, control-flow, call and AST graphs with analysis and DOT/Mermaid export.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test ../../tests/graph/*.test.js",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@sapphire3/core": "workspace:*",
    "vite": "8.3.5"
  },
  "keywords": [
    "sapphire",
    "sapphire3",
    "graph",
    "cfg",
    "call-graph",
    "dependency-graph",
    "sdk"
  ]
}
