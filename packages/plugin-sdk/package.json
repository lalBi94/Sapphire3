{
  "name": "@sapphire3/plugin-sdk",
  "version": "0.1.0",
  "description": "Versioned local plugin SDK for Sapphire 3 widgets, typed native operations and composite nodes.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test ../../tests/plugins/*.test.js",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "keywords": [
    "sapphire",
    "sapphire3",
    "plugin",
    "sdk",
    "widget",
    "native-operation",
    "composite-node"
  ]
}
