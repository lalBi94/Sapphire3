{
  "pluginFormatVersion": 1,
  "apiVersion": 1,
  "id": "org.sapphire3.examples.voltmeter",
  "name": "Digital voltmeter",
  "version": "1.0.0",
  "author": "Sapphire 3 examples",
  "description": "A local digital voltmeter widget with a typed input and a slider output.",
  "permissions": [
    "ui.widgets",
    "workspace.widget-state"
  ],
  "dependencies": [],
  "widgets": [
    {
      "id": "voltmeter",
      "name": "Digital voltmeter",
      "version": "1.0.0",
      "author": "Sapphire 3 examples",
      "description": "Shows a numeric measurement and emits a setpoint when the slider changes.",
      "category": "Instruments",
      "icon": "gauge",
      "defaultSize": {
        "width": 360,
        "height": 250
      },
      "minSize": {
        "width": 240,
        "height": 170
      },
      "properties": [
        {
          "id": "unit",
          "label": "Unit",
          "type": "select",
          "default": "V",
          "options": [
            "V",
            "mV",
            "kV"
          ]
        },
        {
          "id": "maximum",
          "label": "Maximum",
          "type": "float",
          "default": 10
        }
      ],
      "inputs": [
        {
          "id": "value",
          "name": "Voltage",
          "type": {
            "kind": "primitive",
            "name": "double"
          },
          "description": "Bound from a Sapphire variable."
        }
      ],
      "outputs": [
        {
          "id": "setpoint",
          "name": "Setpoint",
          "type": {
            "kind": "primitive",
            "name": "double"
          }
        }
      ],
      "interactions": [
        {
          "id": "setpoint",
          "kind": "slider",
          "label": "Setpoint",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "stateKey": "setpoint",
          "output": "setpoint"
        }
      ],
      "initialState": {
        "value": 0,
        "setpoint": 5
      },
      "renderer": {
        "kind": "stack",
        "children": [
          {
            "kind": "text",
            "text": "LIVE MEASUREMENT"
          },
          {
            "kind": "value",
            "source": "input.value",
            "label": "Voltage",
            "suffix": "{property.unit}",
            "precision": 2
          },
          {
            "kind": "bar",
            "source": "input.value",
            "min": 0,
            "max": 10
          },
          {
            "kind": "divider"
          },
          {
            "kind": "input",
            "interaction": "setpoint"
          }
        ]
      }
    }
  ],
  "nativeOperations": [],
  "composites": []
}
